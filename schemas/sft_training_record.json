{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "title": "sft_training_record",
  "properties": {
    "example_id": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "completion": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "enum": [
        "train",
        "validation"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "enum": [
        "rot13",
        "kazitext"
      ]
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "identity": {
      "type": "object",
      "required": [
        "config_hash",
        "model",
        "method",
        "level",
        "source_manifest_hash",
        "clean_trace_hash"
      ]
    },
    "reasoning": {
      "type": "string",
      "minLength": 1
    },
    "final_answer": {
      "type": "string",
      "minLength": 1
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "enum": [
        "rot13",
        "kazitext"
      ]
    },
    "clean_trace_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "seed": {
      "const": 42
    },
    "model_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "tokenizer_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "original_token_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "transformed_token_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "transformation": {
      "type": "object"
    },
    "config_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_manifest_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "const": "verified"
    }
  },
  "required": [
    "example_id",
    "prompt",
    "completion",
    "reasoning",
    "final_answer",
    "model",
    "model_id",
    "method",
    "family",
    "level",
    "split",
    "clean_trace_hash",
    "source_content_hash",
    "seed",
    "model_revision",
    "tokenizer_revision",
    "original_token_count",
    "transformed_token_count",
    "transformation",
    "config_hash",
    "source_manifest_hash",
    "status",
    "identity"
  ]
}
