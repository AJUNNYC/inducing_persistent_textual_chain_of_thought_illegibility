{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "title": "judge_record",
  "properties": {
    "request_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "request_kind": {
      "enum": [
        "rl_pass_a",
        "rl_pass_b",
        "evaluation_primary",
        "evaluation_secondary",
        "evaluation_audit"
      ]
    },
    "provider": {
      "enum": [
        "openai",
        "anthropic"
      ]
    },
    "requested_model": {
      "type": "string",
      "minLength": 1
    },
    "returned_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "prompt_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "trace_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "schema_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "settings_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "sent",
        "success",
        "timeout",
        "refusal",
        "schema_error",
        "model_mismatch",
        "quota_error",
        "transport_error",
        "blocked"
      ]
    },
    "raw_response": {
      "type": [
        "string",
        "null"
      ]
    },
    "parsed": {
      "type": "object"
    },
    "usage": {
      "type": [
        "object",
        "null"
      ]
    },
    "settings": {
      "type": "object"
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "completed_at": {
      "type": "string",
      "minLength": 1
    },
    "elapsed_seconds": {
      "type": "number",
      "minimum": 0
    },
    "simulation": {
      "type": "boolean"
    },
    "attempts": {
      "type": "array"
    },
    "question_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "request_hash",
    "request_kind",
    "provider",
    "requested_model",
    "prompt_hash",
    "trace_hash",
    "schema_hash",
    "settings_hash",
    "settings",
    "status",
    "started_at",
    "simulation",
    "attempts"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "success"
          }
        }
      },
      "then": {
        "required": [
          "returned_model",
          "raw_response",
          "parsed",
          "usage",
          "completed_at",
          "elapsed_seconds"
        ]
      }
    }
  ]
}
