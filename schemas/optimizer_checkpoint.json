{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "title": "optimizer_checkpoint",
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "complete"
    },
    "identity": {
      "type": "object"
    },
    "progress": {
      "type": "object",
      "properties": {
        "completed_steps": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "completed_steps",
        "sampler_position"
      ]
    },
    "state_keys": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "files": {
      "type": "object"
    },
    "checkpoint_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "version",
    "status",
    "identity",
    "progress",
    "state_keys",
    "files",
    "checkpoint_hash"
  ]
}
