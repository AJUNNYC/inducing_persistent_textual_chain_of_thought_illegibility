# Keep runtime directory markers; never publish generated traces, checkpoints or caches by default.
/data/**
!/data/**/
!/data/**/.gitkeep
/artifacts/**
!/artifacts/**/
!/artifacts/**/.gitkeep
.env
.env.*
*.pem
*.key
__pycache__/
*.pyc
.venv/
.pytest_cache/
.secrets/
*.egg-info/
.cache/
node_modules/
build/
dist/
.env.example
!/.env.example

# npm uses a temporary standard filename from the canonical tracked lock.
tools/mermaid/package-lock.json
